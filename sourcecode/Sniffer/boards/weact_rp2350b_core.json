{
  "build": {
    "arduino": {"earlephilhower": {"boot2_source": "none.S", "usb_vid": "0x2E8A", "usb_pid": "0xF00F"}},
    "core": "earlephilhower",
    "cpu": "cortex-m33",
    "extra_flags": "-DARDUINO_WEACT_RP2350B_CORE -DARDUINO_ARCH_RP2040 -D__PICO_RP2350A=0 -DUSBD_MAX_POWER_MA=250",
    "f_cpu": "150000000L",
    "mcu": "rp2350",
    "variant": "generic_rp2350"
  },
  "debug": {"jlink_device": "RP2350_M33_0", "openocd_target": "rp2350.cfg", "svd_path": "rp2350.svd"},
  "frameworks": ["arduino", "picosdk"],
  "name": "WeAct Studio RP2350B Core (16 MB flash, no assumed PSRAM)",
  "upload": {
    "maximum_ram_size": 524288,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "native_usb": true,
    "use_1200bps_touch": true,
    "wait_for_upload_port": false,
    "protocol": "picotool",
    "protocols": ["picotool", "cmsis-dap", "raspberrypi-swd", "jlink"]
  },
  "url": "https://github.com/WeActStudio/WeActStudio.RP2350BCoreBoard",
  "vendor": "WeAct Studio"
}
